# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string (local dev default shown; use MongoDB Atlas for production)
MONGODB_URI=mongodb://127.0.0.1:27017/wtwr_db

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=replace-with-a-long-random-string

# Port the server listens on
PORT=3001

# Comma-separated list of allowed frontend origins for CORS in production
# e.g. https://wtwr.ugo.si
CLIENT_ORIGIN=

# Cloudflare R2 (S3-compatible object storage) for Album photo/video uploads.
# Create a bucket at dash.cloudflare.com > R2, then generate API credentials
# under "Manage R2 API Tokens". R2_PUBLIC_URL is either the bucket's public
# dev URL (enable "Public access" in the bucket's settings) or a custom
# domain you've connected to the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=wtwr-gallery
R2_PUBLIC_URL=
